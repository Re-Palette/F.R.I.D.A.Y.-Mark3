# ─────────────────────────────────────────────
# F.R.I.D.A.Y. Mark3 — 環境変数
# このファイルを .env.local にコピーして値を設定してください。
#   cp .env.example .env.local
# .env.local は .gitignore 済みです（コミットされません）。
# ─────────────────────────────────────────────

# Google AI Studio で発行した Gemini API キー（必須）
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 会話担当モデル（任意）
# 未設定時は「gemini-3.5-flash-lite → gemini-3.1-flash-lite」の順に使います。
# カンマ区切りで複数指定すると、先頭が無料枠を使い切った・提供されていない場合に次へ自動で切り替えます。
# （無料枠はモデルごとに別枠なので、Flash Lite を 2 つ並べると 1 日の上限が実質 2 倍）
# GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# 合言葉（Web に公開する場合は必須）
# 設定すると、合言葉を入力した端末だけが F.R.I.D.A.Y. を使えます。
# Vercel 上では未設定だと安全のため誰も使えない状態になります。ローカルでは未設定ならロックなし。
FRIDAY_PASSCODE=

# 読み上げの声を ElevenLabs にする（任意）
# 両方を設定すると、音声会話の返答を ElevenLabs の声で読み上げます。未設定ならブラウザ標準の声。
# ElevenLabs が使えないとき（キー誤り・利用枠切れなど）は自動でブラウザの声に切り替わります。
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# モデル（任意）。既定は低遅延の eleven_flash_v2_5。音質重視なら eleven_multilingual_v2
# ELEVENLABS_MODEL=eleven_flash_v2_5
# 話す速さ（任意、0.7〜1.2。既定 1.15）
# ELEVENLABS_SPEED=1.15

# 長期記憶「Obsidian の脳」（任意）
# GitHub の非公開リポジトリを Obsidian の Vault として使い、F.R.I.D.A.Y. が会話の中で思い出し・覚えます。
# トークンは Fine-grained personal access token（対象はそのリポジトリだけ、Contents: Read and write）。
# 空のリポジトリなら、最初の接続時にフォルダと最初のノートを自動で作ります。
BRAIN_GITHUB_TOKEN=
# 例: your-name/friday-brain
BRAIN_REPO=

# 思考レベル（任意）: low | medium | high | off
# 会話の体感速度を優先して既定は low。モデルが非対応の場合は自動で外して再試行します。
GEMINI_THINKING_LEVEL=low

# 生成パラメータ（任意）
GEMINI_TEMPERATURE=0.8
GEMINI_MAX_OUTPUT_TOKENS=2048

# 会話コンテキスト（短期記憶）としてGeminiに送る上限（任意）
CHAT_CONTEXT_MAX_MESSAGES=24
CHAT_CONTEXT_MAX_CHARS=24000

# F.R.I.D.A.Y. が「今日」を判断するためのタイムゾーン（任意）
FRIDAY_TIMEZONE=Asia/Tokyo
