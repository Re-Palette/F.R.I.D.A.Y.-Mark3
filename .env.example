# ─────────────────────────────────────────────
# F.R.I.D.A.Y. Mark3 — 環境変数
# このファイルを .env.local にコピーして値を設定してください。
#   cp .env.example .env.local
# .env.local は .gitignore 済みです（コミットされません）。
# ─────────────────────────────────────────────

# Google AI Studio で発行した Gemini API キー（必須）
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 会話担当モデル（任意）
# 未設定時は "gemini-flash-latest"（Google側で常に最新のFlashを指すエイリアス）を使用。
# 特定バージョンに固定したい場合は例: gemini-3.8-flash / gemini-2.5-flash
GEMINI_MODEL=gemini-flash-latest

# 思考レベル（任意）: low | medium | high | off
# 会話の体感速度を優先して既定は low。モデルが非対応の場合は自動で外して再試行します。
GEMINI_THINKING_LEVEL=low

# 生成パラメータ（任意）
GEMINI_TEMPERATURE=0.8
GEMINI_MAX_OUTPUT_TOKENS=2048

# 会話コンテキスト（短期記憶）としてGeminiに送る上限（任意）
CHAT_CONTEXT_MAX_MESSAGES=24
CHAT_CONTEXT_MAX_CHARS=24000

# F.R.I.D.A.Y. が「今日」を判断するためのタイムゾーン（任意）
FRIDAY_TIMEZONE=Asia/Tokyo
